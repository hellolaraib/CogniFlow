# ==============================================================================
# CogniFlow Configuration Template (.env.example)
# Copy this file to .env and configure your desired settings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Backend API Base URL for the React / Vite frontend
VITE_API_BASE_URL=http://127.0.0.1:8000


# ------------------------------------------------------------------------------
# 2. GENERAL-PURPOSE AI MODEL CONFIGURATION (PHASE 1)
# ------------------------------------------------------------------------------
# AI Provider Selection:
# Options: 'auto' | 'groq' | 'openai' | 'gemini' | 'ollama' | 'custom'
# When set to 'auto', CogniFlow automatically selects the provider based on which
# API key is configured below.
AI_PROVIDER=auto

# Universal AI API Key (used if provider-specific keys below are not set)
AI_API_KEY=

# OPTION A: Groq Cloud (Recommended for ultra-fast, high-accuracy inference)
# Sign up at: https://console.groq.com/keys
GROQ_API_KEY=
# Default model: llama-3.3-70b-versatile or llama-3.1-8b-instant

# OPTION B: OpenAI
# Sign up at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Default model: gpt-4o-mini or gpt-4o

# OPTION C: Google Gemini (Google AI Studio)
# Sign up at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Default model: gemini-2.0-flash

# OPTION D: Local Ollama (Zero cost, 100% private offline inference)
# Install from: https://ollama.com
# Run: ollama run llama3.2
# Ollama Host URL (Default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Custom Model Identifier Override (optional, defaults chosen per provider)
# Examples:
#   - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
#   - OpenAI: gpt-4o-mini, gpt-4o
#   - Gemini: gemini-2.0-flash, gemini-1.5-flash
#   - Ollama: llama3.2, mistral, deepseek-coder
AI_MODEL=

# Custom API Base URL (optional, for custom OpenAI-compatible proxies / vLLM / LocalAI)
# Example: https://api.deepseek.com/v1, https://openrouter.ai/api/v1
AI_API_BASE_URL=

# Request Timeout in seconds (default: 20.0)
AI_REQUEST_TIMEOUT_SECONDS=20.0


# ------------------------------------------------------------------------------
# 3. HOW TO START THE APPLICATION
# ------------------------------------------------------------------------------
# 1. Start the FastAPI backend:
#    ./.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload
#
# 2. Start the React / Vite frontend:
#    npm run dev
#    (Opens on http://localhost:3000)
#
# 3. Test Model Connectivity:
#    curl -s http://127.0.0.1:8000/health
#    Check the "general_llm" block in the JSON output:
#    {
#      "configured": true,
#      "provider": "groq",
#      "model": "llama-3.3-70b-versatile",
#      "status": "operational"
#    }
#
# 4. Troubleshooting & Error Diagnosis:
#    - HTTP 401 / 403: Check that your API key in .env matches the provider format.
#    - HTTP 429: Rate limit hit. Wait a few moments or switch to a different model.
#    - Connection Refused: Ensure Ollama is running (`ollama serve`) or check internet connection.
#    - Timeout: Increase AI_REQUEST_TIMEOUT_SECONDS=30.0 for large models.
